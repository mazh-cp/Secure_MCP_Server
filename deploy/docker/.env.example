# Copy to .env (gitignored) for local/dev, OR export these from your secrets
# manager before `docker compose up`. NEVER commit a populated .env.
#
# Generate strong values:
#   openssl rand -hex 16   # tokens / enrollment secret
#   openssl rand -hex 32   # 32-byte keys (HMAC, keystore master key)

# --- secrets (required) ---
SECURE_MCP_ADMIN_TOKEN=
SECURE_MCP_EDGE_ENROLLMENT_SECRET=
CHECKPOINT_TC_API_KEY=
SECURE_MCP_AUDIT_HMAC_KEY=

# --- secrets (optional) ---
# Set to enable the console's Keys & Secrets tab (AES-256-GCM keystore).
SECURE_MCP_KEYSTORE_MASTER_KEY=

# --- non-secret config (optional overrides) ---
CHECKPOINT_TE_BASE_URL=https://te.checkpoint.com
CHECKPOINT_TC_BASE_URL=https://rep.checkpoint.com
LAKERA_GUARD_BASE_URL=https://api.lakera.ai
SECURE_MCP_EDGE_GROUPS=

# --- publish addresses ---
# Edge is internet-facing (front with TLS / a reverse proxy). Admin stays
# loopback-only on the host by default — reach it via SSH tunnel or internal proxy.
EDGE_PUBLISH_ADDR=0.0.0.0
ADMIN_PUBLISH_ADDR=127.0.0.1
